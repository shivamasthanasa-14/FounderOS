# Publication allowlist. Unknown root files stay local until deliberately reviewed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/app.py
!/founderos/
!/tests/
!/requirements.txt
!/.env.example
!/.streamlit/
!/data/
!/templates/
!/demo_reports/
!/final_demo_reports/
!/docs/
!/n8n/
!/run_analysis.py
!/run_final_demo.py
!/run_reporting_demo.py
!/run_stage3_demo.py
!/run_stage4_demo.py

/.streamlit/*
!/.streamlit/config.toml

/data/*
!/data/customers.csv
!/data/financial_entries.csv
!/data/implementation_milestones.csv
!/data/implementation_projects.csv
!/data/leads.csv
!/data/opportunities.csv
!/data/opportunity_stage_events.csv
!/data/subscription_events.csv
!/data/support_tickets.csv
!/data/team.csv
!/data/team_capacity.csv

/docs/*
!/docs/business_assumptions.md
!/docs/kpi_definitions.md
!/docs/database_schema.sql
!/docs/n8n_setup.md
!/docs/screenshots/

# Shared exclusions; example configuration is intentionally public.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/env/
**/node_modules/
**/.env
**/.env.*
!/.env.example
**/secrets.toml
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.zip
**/*.exe
**/*.msi
**/*.tmp
**/*.bak
**/*~
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/.agents/
**/.codex/
